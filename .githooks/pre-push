#!/usr/bin/env bash
# push 전 — 빠른 게이트 + 동결 브랜치 보호.
# 전체 게이트를 push 마다 요구하면 미구현 필수 항목 때문에 증분 작업 경로가 막힌다 (prist 의 교훈).
# 판정은 셋으로 나뉜다: push = --fast / 머지 = CI 전체 / 마일스톤 종료 = --milestone (.agents/WORKFLOW.md ④)
set -uo pipefail
unset CDPATH
cd "$(git rev-parse --show-toplevel)" || exit 1
R=$'\033[31m'; Y=$'\033[33m'; D=$'\033[2m'; N=$'\033[0m'

# stdin: <local ref> <local sha> <remote ref> <remote sha>
protected_ref=0
while read -r _lref _lsha rref _rsha; do
  case "$rref" in refs/heads/main|refs/heads/kcmvp/*) protected_ref=1 ;; esac
  case "$rref" in
    refs/heads/kcmvp/*)
      if [ -z "${JMS_APPROVED_BY:-}" ]; then
        printf '%s✗ %s 는 검증 제출 동결 브랜치입니다. 변경은 재검증 사유입니다 (docs/RELEASE.md).%s\n' "$R" "${rref#refs/heads/}" "$N" >&2
        printf '%s  사람이 결정했다면: JMS_APPROVED_BY=<이름> git push%s\n' "$D" "$N" >&2
        exit 1
      fi ;;
    refs/heads/main)
      printf '%s▲ main 에 직접 push 합니다. 보통은 PR 로 들어가야 합니다 (docs/RELEASE.md).%s\n' "$Y" "$N" >&2 ;;
  esac
done

if [ "$protected_ref" = 1 ]; then
  printf '%s▶ push 전 빠른 게이트 (./scripts/verify.sh --fast)%s\n' "$Y" "$N"
  ./scripts/verify.sh --fast || exit 1
else
  # 작업 브랜치: 정적 게이트만. 구현 전 TEST: 커밋(빨강)을 올릴 수 있어야 한다 (R1, .agents/WORKFLOW.md ②).
  # 테스트(게이트 6)는 PR 끝에서 CI 가 판정한다.
  printf '%s▶ push 전 정적 게이트 (./scripts/verify.sh --fast --only 0,0b,1,2,3,4,5)%s\n' "$Y" "$N"
  ./scripts/verify.sh --fast --only 0,0b,1,2,3,4,5 || exit 1
fi

printf '\n%s기계가 확인할 수 없는 것:%s\n' "$Y" "$N"
printf '  □ 구현한 에이전트와 다른 에이전트가 리뷰했는가 (R3)\n'
printf '  □ 보호 경로 변경이 있다면 사람 승인을 받았는가 (R4)\n'
printf '  □ 머지 판정은 CI 가 한다 (JMS_REQUIRE_ALL=1 ./scripts/verify.sh)\n'
exit 0
