#!/usr/bin/env bash
# 커밋 메시지 규약 — docs/COMMIT.md
set -uo pipefail
unset CDPATH
cd "$(git rev-parse --show-toplevel)" || exit 1
msg_file="$1"
msg=$(cat "$msg_file")
R=$'\033[31m'; Y=$'\033[33m'; D=$'\033[2m'; N=$'\033[0m'

# git 이 편집기용으로 남기는 주석 줄은 판정에서 뺀다
msg=$(printf '%s\n' "$msg" | grep -v '^#' || true)
first=$(printf '%s' "$msg" | head -1)

# ── 0. 보호 경로 승인 기록 (.agents/APPROVAL.md §승인 기록) ──────
if [ -n "${JMS_APPROVED_BY:-}" ]; then
  if ! printf '%s\n' "$msg" | grep -qx "Approved-by: ${JMS_APPROVED_BY}"; then
    printf '%s✗ JMS_APPROVED_BY=%s 로 커밋하려면 메시지에 트레일러가 있어야 합니다:%s\n\n  Approved-by: %s\n' \
      "$R" "$JMS_APPROVED_BY" "$N" "$JMS_APPROVED_BY" >&2
    exit 1
  fi
fi

# git merge 가 만드는 머지 커밋 — 내용 판정은 pre-commit 과 CI(결합 diff)가 한다. 메시지 규약은 적용하지 않는다.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then exit 0; fi

# ── 1. DCO — 모든 커밋 (revert 포함) ────────────────────────────
if ! printf '%s\n' "$msg" | grep -qE '^Signed-off-by: .+ <.+>$'; then
  printf '%s✗ Signed-off-by 가 없습니다 (DCO, docs/COMMIT.md).%s  git commit -s 로 만드세요.\n' "$R" "$N" >&2
  exit 1
fi

# git 이 만든 merge / revert 와 autosquash 용 커밋만 타입 검사에서 뺀다.
# 접두어만 보면 "Merge 로 시작하는 아무 메시지"가 규약 검사를 전부 건너뛴다.
if printf '%s' "$first" | grep -qE "^Merge (branch|branches|remote-tracking branch|tag|commit|pull request) " \
   || printf '%s' "$first" | grep -qE '^Merge [0-9a-f]{7,40}( into .+)?$'; then exit 0; fi
if printf '%s' "$first" | grep -qE '^Revert ".+"$' && printf '%s' "$msg" | grep -qE '^This reverts commit [0-9a-f]{7,40}\.?$'; then exit 0; fi
case "$first" in fixup!\ *|squash!\ *|amend!\ *) exit 0 ;; esac

# ── 2. 타입과 요약 ───────────────────────────────────────────────
if ! printf '%s' "$first" | grep -qE '^(ADD|FIX|REF|UPT|DEL|TEST|DOCS)(\([a-z0-9-]+\))?: .+'; then
  printf '%s✗ 커밋 메시지 형식 위반%s\n\n  <TYPE>[(범위)]: <한 줄 요약>\n' "$R" "$N" >&2
  printf '  %sADD%s 추가 · %sFIX%s 버그 수정(재현 테스트) · %sREF%s 리팩터링(동작 불변) · %sUPT%s 의존성·툴체인\n' "$Y" "$N" "$Y" "$N" "$Y" "$N" "$Y" "$N" >&2
  printf '  %sDEL%s 제거 · %sTEST%s 테스트·하네스·벡터·코퍼스 · %sDOCS%s 문서·ADR·제출물 초안\n\n' "$Y" "$N" "$Y" "$N" "$Y" "$N" >&2
  printf '%s입력한 첫 줄: %s%s\n' "$D" "$first" "$N" >&2
  exit 1
fi
type=$(printf '%s' "$first" | sed -E 's/^([A-Z]+).*/\1/')
summary=$(printf '%s' "$first" | sed -E 's/^[A-Z]+(\([a-z0-9-]+\))?: //')
[ "${#summary}" -ge 5 ] || { printf '%s✗ 요약이 너무 짧습니다: "%s"%s\n' "$R" "$summary" "$N" >&2; exit 1; }
[ "${#first}" -le 72 ] || printf '%s▲ 첫 줄이 72자를 넘습니다 (%d자).%s\n' "$Y" "${#first}" "$N" >&2

# ── 3. Contracts 트레일러 (ADD / FIX / REF) ──────────────────────
case "$type" in
  ADD|FIX|REF)
    if ! printf '%s\n' "$msg" | grep -qE '^Contracts: (none|C[1-5](, ?C[1-5])*)$'; then
      printf '%s✗ Contracts: 트레일러가 없거나 형식이 틀렸습니다%s  (Contracts: C1, C4 | Contracts: none)\n' "$R" "$N" >&2
      printf '%s"none" 이라고 쓰기 전에 한 번 더 생각하세요. contract-auditor 가 검증합니다.%s\n' "$D" "$N" >&2
      exit 1
    fi ;;
esac

# ── 4. FIX 는 재현 테스트가 함께 ─────────────────────────────────
if [ "$type" = FIX ]; then
  staged_tests=$(git diff --cached --name-only 2>/dev/null | grep -E '(^tests/|/tests/|^fuzz/|proptest-regressions/)' || true)
  in_src=$(git diff --cached -U0 2>/dev/null | grep -c '^+.*#\[test\]' || true)
  if [ -z "$staged_tests" ] && [ "${in_src:-0}" -eq 0 ]; then
    printf '%s▲ FIX: 인데 재현 테스트가 스테이지되지 않았습니다 (.agents/WORKFLOW.md).%s\n' "$Y" "$N" >&2
  fi
fi

# ── 5. 사람 승인 경로는 별도 커밋 ────────────────────────────────
# 분류는 scripts/hooks/protected.tsv (유일한 정의) 를 judge.py --classify 로 읽는다. 목록을 여기 복제하지 않는다.
prot=""; other=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  kind=$(python3 scripts/hooks/judge.py --classify "$f" 2>/dev/null) || { printf '%s✗ 보호 경로 분류 실패: %s%s\n' "$R" "$f" "$N" >&2; exit 1; }
  if [ "$kind" = human ]; then prot="$prot $f"; else other="$other $f"; fi
done < <(git diff --cached --name-only 2>/dev/null)
if [ -n "$prot" ] && [ -n "$other" ]; then
  printf '%s✗ 사람 승인 경로를 다른 변경과 같은 커밋에 섞었습니다 (AGENTS.md R4)%s\n  보호:%s\n  일반:%s\n' "$R" "$N" "$prot" "$other" >&2
  exit 1
fi
if [ -n "$prot" ] && ! printf '%s\n' "$msg" | grep -qE '^Approved-by: .+'; then
  printf '%s✗ 사람 승인 경로 변경에는 Approved-by: 트레일러와 승인자의 서명이 필요합니다%s\n' "$R" "$N" >&2
  printf '%s  JMS_APPROVED_BY=<이름> git commit -s -S  (.agents/APPROVAL.md §승인 기록)%s\n' "$D" "$N" >&2
  exit 1
fi
exit 0
